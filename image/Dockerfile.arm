# onkyo-spotify-connect - ARM image (arm64 / armv7, e.g. Raspberry Pi)
#
# Identical runtime to the x86_64 image, but swyh-rs-cli is compiled from source,
# because swyh-rs publishes its CLI only as an x86_64 AppImage.
# The first build on a Raspberry Pi can take a long time (Rust compile) and needs
# about 2 GB of free RAM+swap; later builds reuse the Docker cache.
#
# Spotify Soloist is NOT included (see Dockerfile) - it is downloaded on container start.

ARG SWYH_VERSION=1.21.1

FROM rust:1-slim-trixie AS swyh
ARG SWYH_VERSION
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git pkg-config build-essential cmake libasound2-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${SWYH_VERSION}" https://github.com/dheijl/swyh-rs /src \
 && cd /src \
 && cargo build --release --no-default-features --features cli --bin swyh-rs-cli \
 && install -m 755 target/release/swyh-rs-cli /usr/local/bin/swyh-rs-cli

FROM debian:trixie-slim

LABEL org.opencontainers.image.title="onkyo-spotify-connect" \
      org.opencontainers.image.description="Spotify Connect for legacy Onkyo network receivers via Spotify Soloist and DLNA" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="Lisek (lisek84)" \
      org.opencontainers.image.source="https://github.com/lisek84/onkyo-spotify-connect"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl tini procps python3 \
      pulseaudio pulseaudio-utils libpulse0 \
      libasound2t64 libasound2-plugins \
 && rm -rf /var/lib/apt/lists/*

COPY --from=swyh /usr/local/bin/swyh-rs-cli /usr/local/bin/swyh-rs-cli
COPY pulse.pa    /etc/pulse/soloist.pa
COPY asound.conf /etc/asound.conf
COPY entrypoint.sh dlna-proxy.py amp-ctl.py now-meta.py iscp-events.py /usr/local/bin/
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/dlna-proxy.py /usr/local/bin/amp-ctl.py \
              /usr/local/bin/now-meta.py /usr/local/bin/iscp-events.py

VOLUME ["/config"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
