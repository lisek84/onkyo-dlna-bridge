# onkyo-dlna-bridge settings.  Copy to "soloist.env" and edit.
# soloist.env contains your secret API key - never commit or share it.

# --- required ------------------------------------------------------------------

# Spotify Soloist API key: https://developer.spotify.com/dashboard/soloist
# (Spotify Premium account required - see docs/spotify-developer-key.md)
SOLOIST_API_KEY=paste_your_key_here

# IP address of the receiver. Give it a fixed IP / DHCP reservation in your router.
RENDERER_IP=192.168.1.50

# --- recommended ---------------------------------------------------------------

# Name shown in the Spotify app (Devices list).
DEVICE_NAME=Onkyo Receiver

# LAN IP of the machine running this container. Leave empty to auto-detect.
# Set it explicitly if the host has several networks (VPN, Docker bridges, ...).
HOST_IP=

# Owner of the ./config directory (run "id" on the host). Synology: usually 1026 / 100.
PUID=1000
PGID=1000

# --- streaming -----------------------------------------------------------------

# TCP port the receiver pulls the audio stream from. ALLOW IT IN THE HOST FIREWALL
# for the receiver's IP (see docs/networking.md).
STREAM_PORT=5901

# Who may fetch the audio stream from STREAM_PORT:
#   renderer          - only the receiver (RENDERER_IP)  [default, recommended]
#   192.168.1.0/24    - a comma-separated list of IPs and/or subnets (e.g. if the receiver's IP changes)
#   (empty)           - anyone in the LAN
# Everyone else gets HTTP 403. This keeps the stream from being captured by other devices.
STREAM_ALLOW=renderer

# Internal swyh-rs port (listens on localhost only; change only on conflicts).
SWYH_PORT=5911

# Initial Spotify (digital) volume 0-100. The receiver volume stays on its remote.
INITIAL_VOLUME=70

# Stop streaming after this many seconds of pause.
IDLE_STOP_SECONDS=300

# --- receiver display ----------------------------------------------------------

# yes = show title / artist / album on the receiver, refreshed on every track change
#       (costs 2-4 s of silence at the start of each track - the DLNA stream is restarted)
# no  = fixed text PLAY_TITLE, gapless
META_UPDATE=yes
PLAY_TITLE=Spotify

# yes = also send the album cover; the receiver shows it on its on-screen display
#       (TV connected via HDMI). Fetched by the receiver directly from Spotify's image CDN over http.
COVER_ART=yes
# Cover image size sent to the receiver: default (300x300), large (640x640), small (64x64).
# The TX-NR609 downscales covers itself, so "large" does not look better there - other renderers may differ.
COVER_SIZE=default

# --- Onkyo eISCP control (Onkyo / Integra / Pioneer network receivers) ----------

# yes = use eISCP (TCP 60128): power on, switch to NET + DLNA before playback,
#       react to the remote. Set "no" for non-Onkyo DLNA renderers.
ONKYO_EISCP=yes

# yes = power the receiver on when you start Spotify on it.
AUTO_POWER_ON=yes

# yes = remote Stop pauses Spotify, the NET button resumes it (within
#       NET_RESUME_SECONDS), switching the receiver off pauses Spotify.
REMOTE_CONTROL=yes
# The NET button also opens the NET menu, so it resumes Spotify only shortly after a Stop.
NET_RESUME_SECONDS=120
# yes = NET pressed while Spotify plays on the receiver skips to the next track (the NET menu cannot
#       be opened during playback then - press Stop first). Stop -> NET still resumes.
NET_NEXT=no
# What switching the receiver off does: pause = pause Spotify (the app stays connected to the receiver);
# release = pause and disconnect - the app goes back to the phone.
POWER_OFF_ACTION=pause

# --- optional receiver integration (eISCP, all off by default) ----------------

# yes = the Spotify volume slider controls the receiver's master volume and the remote/knob moves
#       the slider (both ways). The audio stream stays at full level.
VOLUME_SYNC=no
# Receiver volume that corresponds to 100 % in Spotify - a hard limit for the slider.
VOLUME_MAX=50

# Receiver volume set only when the container itself switches the receiver on.
# Empty = the receiver starts at its usual volume, as it always did (the container never changes it).
# A receiver that is already on is never changed. Independent of VOLUME_SYNC.
POWER_ON_VOLUME=

# yes = when Spotify is done (paused for IDLE_STOP_SECONDS, or moved to another device), switch the
#       receiver back to the input it was on before Spotify took over (e.g. TV).
RESTORE_INPUT=no

# >0 = put the receiver into standby after this many minutes without Spotify - only if the container
#      switched it on and it is still idle on the NET input (not used for anything else meanwhile).
AUTO_POWER_OFF_MINUTES=0

# --- misc ----------------------------------------------------------------------

# yes = also write the log to config/container.log (rotated at 5 MB).
LOG_TO_FILE=yes
